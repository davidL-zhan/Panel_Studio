# AI Panel Studio — repository-wide ignore rules

# ── Environment variables and secrets ──────────────────
**/.env
**/.env.*
!frontend/.env.development
!**/.env.example
!**/.env.*.example
*.pem
*.key
.secrets/

# ── Node.js / Vue / Vite ────────────────────────────────
node_modules/
dist/
dist-ssr/
.vite/
.npm/
.pnpm-store/
*.tsbuildinfo

# ── Python / FastAPI ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
*.egg-info/
build/

# ── Tests and coverage ──────────────────────────────────
coverage/
htmlcov/
.coverage
.coverage.*
.nyc_output/
playwright-report/
test-results/
blob-report/

# ── SQLite runtime data ─────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# ── Logs, caches, and temporary files ───────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.cache/
tmp/
temp/
*.tmp

# ── IDE and OS metadata ─────────────────────────────────
/.vscode/*
!/.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Local AI-tool settings ──────────────────────────────
/.claude/settings.local.json
/.claude/worktrees/
/.codex/
